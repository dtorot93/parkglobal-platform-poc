{
  "type": "record",
  "name": "ZoneState",
  "namespace": "io.parkglobal.topology.state",
  "doc": "ECST · Foto completa del estado público de una zona de parqueo. Dueño: team-zonas. Clave del mensaje: '<countryCode>:<zoneNo>' (string, sin esquema). La jerarquía Ciudad -> Zona se expresa por referencia (cityId), no por anidamiento. Valor nulo = tombstone (zona dada de baja).",
  "fields": [
    { "name": "zoneKey", "type": "string", "doc": "Identidad de la zona, igual a la clave del mensaje. Formato <countryCode>:<zoneNo>." },
    { "name": "countryCode", "type": "string", "doc": "País ISO 3166-1 alfa-2." },
    { "name": "zoneNo", "type": "int", "doc": "Número de zona dentro del país." },
    { "name": "version", "type": "long", "doc": "Versión monotónica por zona (descartar versiones menores o iguales)." },
    { "name": "name", "type": "string", "doc": "Nombre visible de la zona." },
    { "name": "cityId", "type": "string", "doc": "Referencia a la ciudad (p. ej. SE-STO). El consumidor agrupa zonas por ciudad en su vista local." },
    { "name": "cityName", "type": "string", "doc": "Nombre de la ciudad, desnormalizado para que el consumidor no tenga que llamar a otra API." },
    {
      "name": "status",
      "type": { "type": "enum", "name": "ZoneStatus", "symbols": ["ACTIVE", "INACTIVE", "UNKNOWN"], "default": "UNKNOWN" },
      "doc": "Estado operativo de la zona."
    },
    { "name": "timezone", "type": "string", "doc": "Zona horaria IANA." },
    { "name": "updatedAt", "type": { "type": "long", "logicalType": "timestamp-millis" }, "doc": "Momento del commit en Zonas." }
  ]
}
